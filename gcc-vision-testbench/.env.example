# Copy to .env and fill in. Never commit .env.

# Roboflow Universe API key: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# Optional: put data somewhere other than ./data (e.g. an external drive)
# GCCVT_DATA_ROOT=/mnt/bigdisk/gcc-vision-data

# Optional: use a different config folder
# GCCVT_CONFIG_DIR=./config

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
